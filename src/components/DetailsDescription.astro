---
import WhimsyHeader from './WhimsyHeader.astro';
const { title } = Astro.props;
---
<header>
    <WhimsyHeader title={title} color="olive-leaf" />
</header>
<article>
    <p><slot></slot></p>
</article>

<style>
    header {
        margin-bottom: 1em;
        color: var(--olive-leaf);
    }

    article {
        font-size: 1rem;
        line-height: 1.5;
        font-family: 'Sedan', serif;
        color: var(--ink-black);
    }
</style>