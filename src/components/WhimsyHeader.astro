---
const { title, color } = Astro.props;
---

<h2>
 {title}
</h2>

<style> 

    h2 {
        font-size: 2em;
        font-weight: bold;
        margin: 0;
        font-family: 'Mea Culpa', sans-serif;
        color: var(--olive-leaf);
        text-align: center;
    }

    h2::before, h2::after {
        content: '–––––––––– ❦ ––––––––––';
        color: var(--olive-leaf);
        display: block;
        text-align: center;
        font-size: 0.7em;
        font-family: "Montserrat", sans-serif;
        font-weight: 300;
    }
    article {
        font-size: 1rem;
        line-height: 1.5;
        font-family: 'Sedan', serif;
        color: var(--ink-black);
    }
</style>