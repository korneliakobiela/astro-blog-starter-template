---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="internal-links">
			<HeaderLink href="/" class:list={[{ active: Astro.url.pathname === '/' }]}>Home</HeaderLink>
			<HeaderLink href="/ilustracje" class:list={[{ active: Astro.url.pathname === '/ilustracje' }]}>Ilustracje</HeaderLink>
			<HeaderLink href="/dopobrania" class:list={[{ active: Astro.url.pathname === '/dopobrania' }]}>Do pobrania</HeaderLink>
			<HeaderLink href="/omnie/bio" class:list={[{ active: Astro.url.pathname.startsWith('/omnie') }]}>O mnie</HeaderLink>
			<HeaderLink href="/contact" class:list={[{ active: Astro.url.pathname === '/contact' }]}>Kontakt</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: auto;
		padding: 0 1em;
		font-family: 'Cantarell', sans-serif;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		width: 750px;
		margin: 1em auto;
	}
	nav a {
		padding: 0.5em 1.5em;
		margin: 0.5em auto;
		color: var(--floral-white);
		text-decoration: none;
		background-color: var(--dusty-olive);
		text-transform: uppercase;
		font-size: 0.8em;
	}
	nav a:hover {
		text-decoration: none;
		background-color: var(--olive-leaf);
		color: var(--floral-white);
		transition: all 0.3s ease-in-out;
	}
	nav a.active {
		text-decoration: none;
		background-color: var(--olive-leaf);
	}

	.internal-links {
		display: flex;
		align-items: space-between;
		justify-content: space-between;
		margin: auto;
		width: 100%;
	}
</style>
