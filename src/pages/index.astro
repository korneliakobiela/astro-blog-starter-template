---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ThumbnailGrid from '../components/ThumbnailGrid.astro';
import ImageThumbnail from '../components/ImageThumbnail.astro';

type Props = CollectionEntry<'illustrations'>['data'];

const illustrations = (await getCollection('illustrations')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
).slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<ThumbnailGrid>
				{illustrations.map((illustration) => (
					<ImageThumbnail
						src={illustration.data.link}
						alt={illustration.data.polishTitle}
						title={illustration.data.title}
					/>
				))}
			</ThumbnailGrid>
		</main>
		<Footer />
	</body>
</html>
