---
import Header from '../components/Header.astro';
import ImageDetails from '../components/ImageDetails.astro';
import BaseHead from '../components/BaseHead.astro';
import DetailsDescription from '../components/DetailsDescription.astro';
import Footer from '../components/Footer.astro';

const { title, description, image } = Astro.props;
---
<!DOCTYPE html>
<html lang="pl">
<head>
    <BaseHead title={title} description={description} />
</head>
<body>
    <Header></Header>
    <nav class="submenu internal-links">
        <a href="/omnie/bio" class:list={[{ active: Astro.url.pathname === '/omnie/bio' }]}>Bio</a>
        <a href="/omnie/wystawy" class:list={[{ active: Astro.url.pathname === '/omnie/wystawy' }]}>Wystawy</a>

    </nav>
    <main>
        <ImageDetails src={image} alt={title}>
        <DetailsDescription
            title={title}
        >
            <slot></slot>
        </DetailsDescription>
        </ImageDetails>
    </main>
    <Footer></Footer>
</body>
<style>
    .submenu {
        display: flex;
        justify-content: center;
        margin: auto;
        align-items: flex-start;
    }

    .submenu a {
        padding: 0.5em 3em;
        gap: 1em;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 0.8em;
    }

    main {
        padding: 1em;
    }

</style>
</html>